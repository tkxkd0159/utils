#!/usr/bin/env bash
set -euo pipefail

# Defaults if REMOTE not supplied
DEFAULT_REMOTE="${REMOTE:-origin}"

die() { echo "error: $*" >&2; exit 1; }

require_git_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repo"
}

repo_root() { git rev-parse --show-toplevel; }
repo_name() { basename "$(repo_root)"; }
worktrees_dir() { echo "$(repo_root)/../$(repo_name).worktrees"; }

# Return worktree path for a unique name (worktree dir name)
worktree_path_for_unique() {
  local unique="$1"
  local wdir; wdir="$(worktrees_dir)"
  local path="$wdir/$unique"
  if [[ -d "$path" ]]; then
    echo "$path"
    return 0
  fi
  # Fallback: search in git worktree list
  git -C "$(repo_root)" worktree list --porcelain |
    awk -v u="$unique" '/^worktree /{p=$2} /^$/ { if (p~u) { print p; exit } p="" }'
}

# Ensure the remote exists; prompt to add if missing. May rename remote.
# Outputs the chosen remote name on stdout.
ensure_remote() {
  local want="$1"
  if git -C "$(repo_root)" remote get-url "$want" >/dev/null 2>&1; then
    echo "$want"; return 0
  fi
  echo "Remote '$want' not found." >&2
  read -rp "URL for remote '$want': " url
  [ -n "${url:-}" ] || die "remote URL required"
  git -C "$(repo_root)" remote add "$want" "$url"
  echo "$want"
}

parse_ref() {
  local ref="${1:-}"; [[ -n "$ref" ]] || die "branch required"
  local r b
  if [[ "$ref" == *:* ]]; then
    r="${ref%%:*}"
    b="${ref#*:}"
    [[ -n "$r" ]] || die "remote required"
    [[ -n "$b" ]] || die "branch required"
  else
    r="$DEFAULT_REMOTE"
    b="$ref"
  fi
  echo "$r" "$b"
}

cmd_usage() {
  cat <<USAGE
Usage:
  $(basename "$0") install
  $(basename "$0") add [--open] PURPOSE [REMOTE:]BRANCH
  $(basename "$0") open PURPOSE [REMOTE:]BRANCH
  $(basename "$0") cd PURPOSE [REMOTE:]BRANCH
  $(basename "$0") list
  $(basename "$0") remove PURPOSE [REMOTE:]BRANCH

Commands:
  install         Auto-install shell integration (required for 'cd' command)
  add             Create a new worktree for the specified branch
  open            Open an existing worktree in VS Code
  cd              Change to an existing worktree directory (requires 'gw install')
  list            List all git-worktree worktrees managed by this tool
  remove          Remove a worktree and its local branch

Arguments:
  PURPOSE         Required. Purpose/usage for the worktree
                  Examples: review, feature, bugfix, experiment, hotfix
  [REMOTE:]BRANCH Branch to work with. REMOTE defaults to '$DEFAULT_REMOTE' if omitted.

Options:
  --open          Open the new worktree in VS Code after creation (add only)

Quick Start:
  $(basename "$0") install                             # First-time setup (one-time only)
  $(basename "$0") add review feature/new-ui           # Create review worktree
  $(basename "$0") cd review feature/new-ui            # Change to review worktree

Examples:
  $(basename "$0") add feature feature/new-ui          # Create feature worktree
  $(basename "$0") add --open bugfix bug-123           # Create and open bugfix worktree
  $(basename "$0") cd feature upstream:feature/new-ui  # Change to feature worktree (upstream remote)
  $(basename "$0") open experiment test-idea           # Open experiment worktree
  $(basename "$0") list                                # List all managed worktrees
  $(basename "$0") remove feature feature/new-ui       # Remove feature worktree

Notes:
- Run '$(basename "$0") install' once to enable the 'cd' command
- Worktrees live under ../\$(basename REPO).worktrees/
- Target branch name pattern: '<remote>-<branch>-gwt-<purpose>'
- PURPOSE is always required to make worktree intent explicit
USAGE
}

cmd_add() {
  local open_in_vscode="$1"; shift
  local unique="$1"; shift
  local ref="${1:-}"

  require_git_repo

  # Check if unique name is already in use
  local wdir; wdir="$(worktrees_dir)"
  local path="$wdir/$unique"
  if [[ -d "$path" ]]; then
    die "unique name '$unique' already in use at: $path"
  fi

  # Detect if ref is a SHA (40 hex chars or short SHA)
  if [[ "$ref" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
    local sha="$ref"
    # Validate SHA exists
    if ! git -C "$(repo_root)" cat-file -e "$sha"^{commit} 2>/dev/null; then
      die "commit '$sha' not found"
    fi
    git -C "$(repo_root)" worktree add "$path" "$sha"
    echo "Worktree created at: $path (sha: $sha, unique: $unique)"
    if [[ "$open_in_vscode" == "true" ]]; then
      if ! command -v code >/dev/null 2>&1; then
        echo "warning: 'code' command not found. Cannot open in VS Code." >&2
        return
      fi
      echo "Opening in VS Code..."
      code "$path"
    fi
    return
  fi

  # Otherwise, treat as branch
  read -r remote branch < <(parse_ref "$ref")
  remote="$(ensure_remote "$remote")"

  # Ensure the remote-tracking ref exists
  git -C "$(repo_root)" fetch "$remote" "$branch"

  git -C "$(repo_root)" worktree add -B "$unique" "$path" "$remote/$branch"
  echo "Worktree created at: $path (branch: $remote/$branch, unique: $unique)"
  if [[ "$open_in_vscode" == "true" ]]; then
    if ! command -v code >/dev/null 2>&1; then
      echo "warning: 'code' command not found. Cannot open in VS Code." >&2
      return
    fi
    echo "Opening in VS Code..."
    code "$path"
  fi
}

cmd_open() {
  local unique="$1"; shift
  require_git_repo
  local path; path="$(worktree_path_for_unique "$unique")"
  if [[ -z "$path" ]]; then
    die "worktree for unique name '$unique' not found. Use 'gw add $unique ...' to create it first."
  fi
  if ! command -v code >/dev/null 2>&1; then
    die "'code' command not found. Cannot open in VS Code."
  fi
  echo "Opening worktree at: $path"
  code "$path"
}

cmd_cd() {
  local unique="$1"; shift
  require_git_repo
  local path; path="$(worktree_path_for_unique "$unique")"
  if [[ -z "$path" ]]; then
    die "worktree for unique name '$unique' not found. Use 'gw add $unique ...' to create it first."
  fi
  if [[ -z "${GW_WRAPPER:-}" ]]; then
    cat >&2 <<'INTEGRATION_HELP'
The 'cd' command requires shell integration to work.

Run this command to auto-install:
  gw install

Or manually add this function to your ~/.bashrc or ~/.zshrc:

  gw() {
    if [[ "$1" == "cd" ]]; then
      eval "$(GW_WRAPPER=1 command gw "$@")"
    else
      command gw "$@"
    fi
  }

Then reload your shell: source ~/.bashrc
INTEGRATION_HELP
    exit 1
  fi
  echo "cd \"$path\""
}

cmd_list() {
  require_git_repo
  local wdir; wdir="$(worktrees_dir)"
  for d in "$wdir"/*; do
    [[ -d "$d" ]] || continue
    local unique; unique="$(basename "$d")"
    echo "$unique   $d"
  done
}

cmd_remove() {
  local unique="$1"; shift
  require_git_repo
  local wdir; wdir="$(worktrees_dir)"
  local path="$wdir/$unique"
  local acted=false
  if [[ -d "$path" ]]; then
    local current_dir; current_dir="$(pwd -P)"
    local worktree_path; worktree_path="$(cd "$path" && pwd -P)"
    if [[ "$current_dir" == "$worktree_path"* ]]; then
      die "cannot remove worktree: your current terminal session is inside this worktree ($path). Please 'cd' to another directory first."
    fi
    git -C "$(repo_root)" worktree remove --force "$path"
    acted=true
  fi
  if git -C "$(repo_root)" show-ref --verify --quiet "refs/heads/$unique"; then
    git -C "$(repo_root)" branch -D "$unique"
    acted=true
  fi
  if $acted; then
    echo "removed: $unique"
  else
    echo "do nothing: $unique not found"
  fi
}

cmd_install() {
  local shell_name=""
  local rc_file=""
  # Detect shell: if running under sudo, get the actual user's shell
  if [[ -n "${SUDO_USER:-}" ]]; then
    if command -v getent >/dev/null 2>&1; then
      # Linux
      shell_name=$(getent passwd "$SUDO_USER" | cut -d: -f7 | xargs basename)
    elif command -v dscl >/dev/null 2>&1; then
      # macOS
      shell_name=$(dscl . -read "/Users/$SUDO_USER" UserShell | awk '{print $2}' | xargs basename)
    else
      # Fallback: read /etc/passwd directly
      shell_name=$(grep "^$SUDO_USER:" /etc/passwd | cut -d: -f7 | xargs basename)
    fi
  else
    # Normal execution - use current shell
    shell_name="${SHELL##*/}"
  fi

  local user_home=""
  if [[ -n "${SUDO_USER:-}" ]]; then
    # Running under sudo - get the real user's home
    user_home=$(eval echo "~$SUDO_USER")
  else
    user_home="$HOME"
  fi

  # Detect shell and rc file
  case "$shell_name" in
    bash)
      rc_file="$user_home/.bashrc"
      ;;
    zsh)
      rc_file="$user_home/.zshrc"
      ;;
    *)
      die "unsupported shell: $shell_name (only bash and zsh are supported)"
      ;;
  esac

  # Check if already installed
  if [[ -f "$rc_file" ]] && grep -q "gw() {" "$rc_file" 2>/dev/null; then
    echo "Shell integration already installed in $rc_file"
    echo "The 'gw cd' command should work after restarting your shell."
    return 0
  fi

  # Shell function to install
  local function_code
  read -r -d '' function_code <<'EOF' || true
# Git worktree wrapper function for gw cd command
gw() {
  if [[ "$1" == "cd" ]]; then
    eval "$(GW_WRAPPER=1 command gw "$@")"
  else
    command gw "$@"
  fi
}
EOF

  # Add to rc file
  echo "$function_code" >> "$rc_file"

  echo "✓ Shell integration installed to $rc_file"
  echo ""
  echo "To activate, run one of:"
  echo "  source $rc_file"
  echo "  exec $shell_name"
  echo "  # Or just restart your terminal"
  echo ""
  echo "After that, 'gw cd' will work like a native cd command!"
  return 0
}

main() {
  # Check for --help/-h anywhere in arguments (show help regardless of position)
  for arg in "$@"; do
    if [[ "$arg" == "-h" ]] || [[ "$arg" == "--help" ]]; then
      cmd_usage
      return 0
    fi
  done

  local open_in_vscode=false
  local args=()

  # Parse flags (only --open)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --open)
        open_in_vscode=true
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  # Restore positional parameters without flags
  set -- "${args[@]}"

  local cmd="${1:-}"; shift || true
  case "$cmd" in
    install)
      cmd_install
      ;;
    add)
      local unique="${1:-}"
      [[ -n "$unique" ]] || die "UNIQUE_NAME required. Usage: gw add [--open] UNIQUE_NAME [REMOTE:]BRANCH|SHA"
      shift
      cmd_add "$open_in_vscode" "$unique" "${1:-}"
      ;;
    open)
      local unique="${1:-}"
      [[ -n "$unique" ]] || die "UNIQUE_NAME required. Usage: gw open UNIQUE_NAME"
      shift
      cmd_open "$unique"
      ;;
    cd)
      local unique="${1:-}"
      [[ -n "$unique" ]] || die "UNIQUE_NAME required. Usage: gw cd UNIQUE_NAME"
      shift
      cmd_cd "$unique"
      ;;
    remove)
      local unique="${1:-}"
      [[ -n "$unique" ]] || die "UNIQUE_NAME required. Usage: gw remove UNIQUE_NAME"
      shift
      cmd_remove "$unique"
      ;;
    list)
      cmd_list
      ;;
    -h|--help|"")
      cmd_usage
      ;;
    *)
      die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
